<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>WinSelect</AssemblyName><RootNamespace>WinSelect</RootNamespace>
    <PlatformTarget>x64</PlatformTarget><OutputPath>bin\$(Configuration)\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>WinSelect.ico</ApplicationIcon>
    <Optimize>true</Optimize><AppConfig>WinSelect.exe.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Xml"/><Reference Include="System.Xaml"/>
    <Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
    <Compile Include="src\Native.cs"/><Compile Include="src\Storage.cs"/><Compile Include="src\DisplayService.cs"/>
    <Compile Include="src\Views.cs"/><Compile Include="src\Program.cs"/><Compile Include="src\AssemblyInfo.cs"/>
    <Compile Include="src\TrayMenuWindow.cs"/>
    <EmbeddedResource Include="WinSelect.ico"><LogicalName>WinSelect.Icon</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
